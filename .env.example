# Copy to .env and adjust. Loaded by `npm run` scripts through `node --env-file-if-exists=.env`.
NODE_ENV=development
LOG_LEVEL=info
DATABASE_URL=postgres://plent:plent@localhost:5432/plent

# GCP_PROJECT=plent-dev

# The agent's model. Each model has its own Vertex location, wherever Vertex serves it;
# only EU locations are accepted unless MODEL_ALLOW_NON_EU=true.
# MODEL_PROVIDER=anthropic          # anthropic (Claude on Vertex) or google (Gemini)
# MODEL_ID=claude-haiku-5-5
# MODEL_LOCATION=eu                 # e.g. eu, europe-west1, europe-west4
# MODEL_BASE_URL=                   # optional endpoint override
# MODEL_ALLOW_NON_EU=false
