# Copy to .env and adjust. Loaded by `npm run` scripts through `node --env-file-if-exists=.env`.
NODE_ENV=development
LOG_LEVEL=info
DATABASE_URL=postgres://plent:plent@localhost:5432/plent

# GCP_PROJECT=plent-dev

# The agent's model, one of:
# - Through Vertex AI (GCP credentials). Each model has its own location, wherever Vertex serves
#   it; only EU locations are accepted unless MODEL_ALLOW_NON_EU=true. Needs GCP_PROJECT.
# MODEL_PROVIDER=vertex-anthropic     # vertex-anthropic (Claude) or vertex-google (Gemini)
# MODEL_ID=claude-haiku-5-5
# MODEL_LOCATION=eu                   # e.g. eu, europe-west1, europe-west4
# MODEL_ALLOW_NON_EU=false
#
# - Straight to the Anthropic, Gemini or OpenAI API with a key, for local testing without GCP.
#   Refused when NODE_ENV=production.
# MODEL_PROVIDER=anthropic            # anthropic (Claude), google (Gemini) or openai
# MODEL_ID=claude-haiku-5-5
# ANTHROPIC_API_KEY=
# GOOGLE_GENERATIVE_AI_API_KEY=
# OPENAI_API_KEY=
#
# MODEL_BASE_URL=                     # optional endpoint override, either way
